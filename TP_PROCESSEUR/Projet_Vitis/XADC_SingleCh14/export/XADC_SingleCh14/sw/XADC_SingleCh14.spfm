<?xml version="1.0" encoding="UTF-8"?>
<sdx:platform sdx:vendor="xilinx.com"
              sdx:library="sdx"
              sdx:name="XADC_SingleCh14"
              sdx:version="1.0"
              sdx:schemaVersion="1.0"
              xmlns:sdx="http://www.xilinx.com/sdx">
    <sdx:description>
XADC_SingleCh14
    </sdx:description>
    <sdx:systemConfigurations sdx:defaultConfiguration="XADC_SingleCh14">
        <sdx:configuration sdx:name="XADC_SingleCh14"
                           sdx:displayName="XADC_SingleCh14"
                           sdx:defaultProcessorGroup="standalone_ps7_cortexa9_0"
                           sdx:runtimes="cpp">
            <sdx:description>XADC_SingleCh14</sdx:description>
            <sdx:bootImages sdx:default="standard">
                <sdx:image sdx:name="standard"
                            sdx:bif="XADC_SingleCh14/boot/XADC_SingleCh14.bif"
                            sdx:readme="XADC_SingleCh14/boot/generic.readme"
                            sdx:qemuArguments="XADC_SingleCh14/qemu/qemu_args.txt"
                            />
                <sdx:image sdx:name="standalone_ps7_cortexa9_0"
                            sdx:bif="XADC_SingleCh14/boot/XADC_SingleCh14.bif"
                            sdx:readme="XADC_SingleCh14/boot/generic.readme"
                            sdx:qemuArguments="XADC_SingleCh14/standalone_ps7_cortexa9_0/qemu/qemu_args.txt"
                            />
            </sdx:bootImages>
            <sdx:processorGroup sdx:name="standalone_ps7_cortexa9_0"
                                sdx:displayName="standalone_ps7_cortexa9_0"
                                sdx:cpuType="cortex-a9"
                                sdx:cpuInstance="ps7_cortexa9_0">
                <sdx:os sdx:name="standalone"
                        sdx:displayName="standalone"
                        sdx:bspLibraryPaths="XADC_SingleCh14/standalone_ps7_cortexa9_0/bsplib/lib"
                        sdx:bspIncludePaths="XADC_SingleCh14/standalone_ps7_cortexa9_0/bspinclude/include"
                        sdx:bspConfig="XADC_SingleCh14/standalone_ps7_cortexa9_0/system.mss"
                />
            </sdx:processorGroup>
        </sdx:configuration>
    </sdx:systemConfigurations>
</sdx:platform>
