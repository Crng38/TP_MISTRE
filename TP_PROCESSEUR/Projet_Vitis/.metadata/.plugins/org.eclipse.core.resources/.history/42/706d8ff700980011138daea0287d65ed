/*
 * helloworld.c: simple test application
 *
 * This application configures UART 16550 to baud rate 9600.
 * PS7 UART (Zynq) is not initialized by this application, since
 * bootrom/bsp configures it to baud rate 115200
 *
 * ------------------------------------------------
 * | UART TYPE   BAUD RATE                        |
 * ------------------------------------------------
 *   uartns550   9600
 *   uartlite    Configurable only in HW design
 *   ps7_uart    115200 (configured by bootrom/bsp)
 */

#include <stdio.h>
#include "platform.h"
#include "xil_printf.h"

/* Private include */
#include "Timer_48_AXI.h" //Pour accès macro réécriture
#include "xparameters.h" //Pour accès adrese de base timer
#include "sleep.h" //Pour sleep

/* Définition constante */
#define precharge_low_offset TIMER_48_AXI_S00_AXI_SLV_REG0_OFFSET //Offset registre slave 0 / precharge low bits
#define precharge_high_offset TIMER_48_AXI_S00_AXI_SLV_REG1_OFFSET //Offset registre slave 1 / precharge high bits
#define duree_low_offset TIMER_48_AXI_S00_AXI_SLV_REG2_OFFSET //Offset registre slave 2 / duree low bits
#define duree_high_offset TIMER_48_AXI_S00_AXI_SLV_REG3_OFFSET //Offset registre slave 3 / duree high bits
#define raz_cif_offset TIMER_48_AXI_S00_AXI_SLV_REG4_OFFSET //Offset registre slave 4 / registre duree

#define RAZ_flag 1 << 0 //macro pour le flag RAZ
#define CIF_flag 1 << 1 //macro pour le flag CIF

/* Definition fonctions */
void precharge (unsigned long long val_precharge); //Pour changer la valeur du registre prechage
void razFlagCompteur (void); //Pour générer une impulsion sur RAZ
int litCIF (void); //Pour lecture état flag CIF
unsigned long long litDuree (void); //Pour lire la valeur du registre durée





int main()
{
    init_platform();

    print("Hello World\n\r");
    print("Successfully ran Hello World application");

    while(1)
    {
    	/* Sans IT */
    	 precharge (0); //Valeur de base 0
    	 //precharge (4.9E9); //Valeur de base 49E9
    	 printf("Attente passage switch sur 1\n\r");
    	 while(litCIF()); //Tant qu'on a un 1 sur le flag CIF
    	 razFlagCompteur(); //Remise à 0 RAZ
    	 printf("Attente passage switch sur 0\n\r");
    	 while(!litCIF()); //Tant qu'on a un 0 sur le flag CIF
    	 printf("Nb ilpulsions mesurée entre deux fronts: %ull, soit %.9f secondes \n\r", litDuree(), ((float) (litDuree()))*1.25E-9); //Affichage nb secondes
    }
    cleanup_platform();
    return 0;
}

/* Définition code fonctions */

/*
 * @brief: Fonction permettant de changer la valeur du registre precharge
 * @param: nouvelle valeur pour le registre precharge
 *
*/
void precharge (unsigned long long val_precharge)
{
	TIMER_48_AXI_mWriteReg(XPAR_TIMER_48_AXI_0_S00_AXI_BASEADDR, precharge_low_offset, (uint32_t) (val_precharge & 0xFFFFFFFF)); //Ecriture dans registre bas valeur de precharge
	TIMER_48_AXI_mWriteReg(XPAR_TIMER_48_AXI_0_S00_AXI_BASEADDR, precharge_high_offset, (uint32_t) ((val_precharge >> 32) & 0xFFFFFFFF)); //Ecriture dans registre bas valeur de precharge
}

/*
 * @brief: Fonction permettant de générer une impulsion sur le flag RAZ
*/
void razFlagCompteur(void)
{
	TIMER_48_AXI_mWriteReg(XPAR_TIMER_48_AXI_0_S00_AXI_BASEADDR, raz_cif_offset, (uint32_t) (TIMER_48_AXI_mReadReg(XPAR_TIMER_48_AXI_0_S00_AXI_BASEADDR, raz_cif_offset) | RAZ_flag)); //Bit 0 à 1, le reste à 0
	usleep(10); //Attente 10 us
	TIMER_48_AXI_mWriteReg(XPAR_TIMER_48_AXI_0_S00_AXI_BASEADDR, raz_cif_offset, (uint32_t) (TIMER_48_AXI_mReadReg(XPAR_TIMER_48_AXI_0_S00_AXI_BASEADDR, raz_cif_offset) & ~RAZ_flag)); //Bit 0 à 1, le reste à 0
}


/*
 * @brief: Fonction permettant de lire la valeur de CIF
 * @return: valeur du bit 1 du registre raz_cif
 *
*/
int litCIF (void) //Pour lecture état flag CIF
{
	return ((TIMER_48_AXI_mReadReg(XPAR_TIMER_48_AXI_0_S00_AXI_BASEADDR, raz_cif_offset) & CIF_flag) >> 1) & 1; //Renvoi uniquement le bit 1
}

/*
 * @brief: Fonction permettant de lire la valeur du registre durée
 * @return: valeur du bit 1 du registre raz_cif
 *
*/
unsigned long long litDuree (void) //Pour lire la valeur du registre durée
{
	return (((unsigned long long) (TIMER_48_AXI_mReadReg(XPAR_TIMER_48_AXI_0_S00_AXI_BASEADDR, duree_high_offset))) << 32) + (((unsigned long long) (TIMER_48_AXI_mReadReg(XPAR_TIMER_48_AXI_0_S00_AXI_BASEADDR, duree_low_offset)))); //Renvoi la valeur de duree sous forme d'un long long
}


