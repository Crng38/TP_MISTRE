<?xml version="1.0" encoding="UTF-8"?>
<sdx:platform sdx:vendor="xilinx.com"
              sdx:library="sdx"
              sdx:name="PS_ET_BRAM"
              sdx:version="1.0"
              sdx:schemaVersion="1.0"
              xmlns:sdx="http://www.xilinx.com/sdx">
    <sdx:description>
PS_ET_BRAM
    </sdx:description>
    <sdx:systemConfigurations sdx:defaultConfiguration="PS_ET_BRAM">
        <sdx:configuration sdx:name="PS_ET_BRAM"
                           sdx:displayName="PS_ET_BRAM"
                           sdx:defaultProcessorGroup="standalone_ps7_cortexa9_0"
                           sdx:runtimes="cpp">
            <sdx:description>PS_ET_BRAM</sdx:description>
            <sdx:bootImages sdx:default="standard">
                <sdx:image sdx:name="standard"
                            sdx:bif="PS_ET_BRAM/boot/PS_ET_BRAM.bif"
                            sdx:readme="PS_ET_BRAM/boot/generic.readme"
                            sdx:qemuArguments="PS_ET_BRAM/qemu/qemu_args.txt"
                            />
                <sdx:image sdx:name="standalone_ps7_cortexa9_0"
                            sdx:bif="PS_ET_BRAM/boot/PS_ET_BRAM.bif"
                            sdx:readme="PS_ET_BRAM/boot/generic.readme"
                            sdx:qemuArguments="PS_ET_BRAM/standalone_ps7_cortexa9_0/qemu/qemu_args.txt"
                            />
            </sdx:bootImages>
            <sdx:processorGroup sdx:name="standalone_ps7_cortexa9_0"
                                sdx:displayName="standalone_ps7_cortexa9_0"
                                sdx:cpuType="cortex-a9"
                                sdx:cpuInstance="ps7_cortexa9_0">
                <sdx:os sdx:name="standalone"
                        sdx:displayName="standalone"
                        sdx:bspLibraryPaths="PS_ET_BRAM/standalone_ps7_cortexa9_0/bsplib/lib"
                        sdx:bspIncludePaths="PS_ET_BRAM/standalone_ps7_cortexa9_0/bspinclude/include"
                        sdx:bspConfig="PS_ET_BRAM/standalone_ps7_cortexa9_0/system.mss"
                />
            </sdx:processorGroup>
        </sdx:configuration>
    </sdx:systemConfigurations>
</sdx:platform>
